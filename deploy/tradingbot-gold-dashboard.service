[Unit]
Description=Gold-Bot Dashboard
After=network-online.target

[Service]
User=bot
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/tradingbot.env
ExecStart=/opt/trading-bot/.venv/bin/python -m tradingbot --config gold.yaml dashboard --port 8081
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
